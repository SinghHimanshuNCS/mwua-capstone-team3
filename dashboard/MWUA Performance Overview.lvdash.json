    {
      "name": "292e9db1",
      "displayName": "ds_spend_by_zone",
      "queryLines": [
        "WITH erp_dedup AS (\r\n",
        "  SELECT DISTINCT zone, project_code, erp_spend FROM mwua_capstone_team3.gold_mwua.fct_spend\r\n",
        "),\r\n",
        "contractor_dedup AS (\r\n",
        "  SELECT DISTINCT zone, contractor_id, contractor_spend FROM mwua_capstone_team3.gold_mwua.fct_spend\r\n",
        "),\r\n",
        "zones AS (SELECT DISTINCT zone FROM mwua_capstone_team3.gold_mwua.fct_spend)\r\n",
        "SELECT\r\n",
        "  z.zone,\r\n",
        "  COALESCE(e.total_erp_spend, 0) AS total_erp_spend,\r\n",
        "  COALESCE(c.total_contractor_spend, 0) AS total_contractor_spend,\r\n",
        "  COALESCE(e.total_erp_spend, 0) + COALESCE(c.total_contractor_spend, 0) AS total_spend\r\n",
        "FROM zones z\r\n",
        "LEFT JOIN (SELECT zone, SUM(erp_spend) AS total_erp_spend FROM erp_dedup GROUP BY zone) e ON z.zone = e.zone\r\n",
        "LEFT JOIN (SELECT zone, SUM(contractor_spend) AS total_contractor_spend FROM contractor_dedup GROUP BY zone) c ON z.zone = c.zone"
      ],
      "catalog": "mwua_capstone_team3",
      "schema": "default"
    },
    {
      "name": "12011ab9",
      "displayName": "ds_spend_by_project",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  project_code,\n",
        "  erp_spend\n",
        "FROM\n",
        "  mwua_capstone_team3.gold_mwua.fct_spend\n",
        "WHERE\n",
        "  project_code IS NOT NULL"
      ],
      "catalog": "mwua_capstone_team3",
      "schema": "default"
    },
    {
      "name": "b2a5f3b7",
      "displayName": "ds_contractor_activity",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  contractor_id,\n",
        "  contractor_spend,\n",
        "  workorder_count\n",
        "FROM\n",
        "  mwua_capstone_team3.gold_mwua.fct_spend"
      ],
      "catalog": "mwua_capstone_team3",
      "schema": "default"
    },
    {
      "name": "6fe1b859",
      "displayName": "ds_reliability_by_zone",
      "queryLines": [
        "SELECT   zone,   reading_type,   SUM(reading_count) AS total_readings,   SUM(suspect_count) AS total_suspect,   SUM(zone_mismatch_count) AS total_mismatch,   1 - (SUM(suspect_count) + SUM(zone_mismatch_count)) / SUM(reading_count) AS reliability_pct FROM mwua_capstone_team3.gold_mwua.fct_network_health GROUP BY zone, reading_type"
      ],
      "catalog": "mwua_capstone_team3",
      "schema": "default"
    },
    {
      "name": "1db9826f",
      "displayName": "ds_unreliable_readings",
      "queryLines": [
        "SELECT zone, reading_date, reading_type, \r\n",
        "       avg_reading_value, reliability_pct, \r\n",
        "       suspect_count, zone_mismatch_count\r\n",
        "FROM mwua_capstone_team3.gold_mwua.fct_network_health\r\n",
        "WHERE reliability_pct < 0.9\r\n",
        "ORDER BY reliability_pct ASC"
      ]
    }
  ],
